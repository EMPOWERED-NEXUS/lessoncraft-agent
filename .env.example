# Copy to .env.local and fill in locally. Never commit secrets.

# Local LessonCraft server
PORT=8787
LEARNER_ID=demo-learner
LESSON_PACK_ID=
LESSONCRAFT_TEST_MODE=0

# Foundation model (OpenAI-compatible). Leave empty to use deterministic tutor.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Zetaris — set only the values your instance actually uses.
# Do not guess. Leave blank until you have confirmed local connection details.
# UI origin has no path (example shape only): http://localhost:3000
ZETARIS_BASE_URL=
# Direct API base ending in /api/v1.0 (example shape only): http://localhost:8888/api/v1.0
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_QUERY_LIMIT=100
ZETARIS_ENGINE_ID=

# Optional: qualified table to read permitted lessons. Unset = local catalog only.
# Do not point this at NY_TAXI or other sample data.
ZETARIS_LESSON_TABLE=

# Nexus Pathways Lightning JDBC. Leave blank until a login is confirmed.
# Documented URL shape from the local gateway README: jdbc:zetaris:lightning@127.0.0.1:10000
# Use the Lightning JDBC jar in the gateway jdbc/ folder. Do not use a Hive or Spark driver.
ZETARIS_JDBC_URL=
ZETARIS_JDBC_JAR=
ZETARIS_JDBC_USER=
ZETARIS_JDBC_PASSWORD=
JAVA_BIN=

# Learner sign-in. Leave blank. This app does not treat Zetaris credentials as a learner account.
AUTH_PROVIDER=

# NVIDIA Nemotron. Leave the key blank. Pathways calls NVIDIA only with this key and explicit learner consent.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
